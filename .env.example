# DATABASE_URL=postgres://postgres:postgres@localhost:5432/aa_jewellers
DATABASE_URL=#{DB_URL}
# Login password for the owner
# Random string that signs the login cookie: openssl rand -hex 32
AUTH_SECRET=#{AUTH_SECRET}
# Decides what "today" means on the dashboard. e.g. Asia/Kathmandu, Asia/Kolkata, Asia/Karachi
APP_TIMEZONE=Asia/Kathmandu
