{
  "name": "aa-jewellers",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run migrate && next dev",
    "build": "npm run migrate && next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node lib/stats.test.ts",
    "migrate": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env --env-file-if-exists=.env.local lib/migrate.mts",
    "user": "npm run migrate --silent && node --disable-warning=ExperimentalWarning --env-file-if-exists=.env --env-file-if-exists=.env.local lib/user.mts"
  },
  "dependencies": {
    "next": "16.4.0",
    "postgres": "^3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
